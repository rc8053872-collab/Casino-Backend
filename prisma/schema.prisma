  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
  }

  enum Role {
    USER
    ADMIN
    SUPER_ADMIN
  }

  enum Status {
    ACTIVE
    INACTIVE
    BANNED
  }

  enum TxType {
    DEPOSIT
    WITHDRAWAL
    BET
    WIN
    REFUND
    BONUS
    ADJUSTMENT
  }

  enum TxStatus {
    PENDING
    COMPLETED
    FAILED
    ROLLED_BACK
  }

  enum RoundStatus {
    OPEN
    RESOLVED
    CANCELLED
  }

  model User {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    username     String?   @unique
    mobile       String?   @unique
    email        String?   @unique
    googleId     String?
    passwordHash String
    role         Role      @default(USER)
    status       Status    @default(ACTIVE)
    wallet       Wallet?
    sessions     Session[]
    referralCode      ReferralCode?
    referredByCode    String?
    referralBonusAwardedAt DateTime?
    gameCloudPlayerId String?  // GameCloud's internal player ID (auto-mapped on first contact)
    gcMappingPending  Boolean? // True while waiting for GameCloud first balance call
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
  }

  model ReferralCode {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @unique @db.ObjectId
    user      User     @relation(fields: [userId], references: [id])
    code      String   @unique
    createdAt DateTime @default(now())
  }

  model Session {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    user      User     @relation(fields: [userId], references: [id])
    token     String   @unique
    device    String?
    ip        String?
    expiresAt DateTime
    createdAt DateTime @default(now())
  }

  model Wallet {
    id            String        @id @default(auto()) @map("_id") @db.ObjectId
    userId        String        @unique @db.ObjectId
    user          User          @relation(fields: [userId], references: [id])
    balance       Float         @default(0.00)
    lockedBalance Float         @default(0.00)
    totalDeposited Float        @default(0.00)
    totalWithdrawn Float        @default(0.00)
    totalWon      Float         @default(0.00)
    totalLost     Float         @default(0.00)
    currency      String        @default("INR")
    status        Status        @default(ACTIVE)
    transactions  Transaction[]
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
  }

  model Transaction {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    walletId       String   @db.ObjectId
    wallet         Wallet   @relation(fields: [walletId], references: [id])
    amount         Float
    type           TxType
    status         TxStatus
    balanceBefore  Float?
    balanceAfter   Float?
    currency       String   @default("INR")
    referenceId    String?   // External reference (provider transaction id)
    idempotencyKey String   @unique
    gameId         String?  @db.ObjectId // added gameId if applicable
    gameHistoryId  String?  @db.ObjectId
    description    String?
    metadata       Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt
  }

  model Provider {
    id                  String        @id @default(auto()) @map("_id") @db.ObjectId
    name                String        @unique
    slug                String        @unique
    status              Status        @default(ACTIVE)
    apiBaseUrl          String?
    launchEndpoint      String?
    supportedCurrencies String[]      @default([])
    metadata            Json?
    games               Game[]
  }

  model Game {
    id                  String        @id @default(auto()) @map("_id") @db.ObjectId
    
    // --- EXISTING PRESERVED FIELDS ---
    slug                String        @unique
    name                String
    category            String
    provider            String?
    providerId          String
    thumbnail           String?
    status              Status        @default(ACTIVE)
    minBet              Float?
    maxBet              Float?
    displayOrder        Int           @default(0)
    supportedCurrencies String[]      @default([]) // e.g. ["INR", "PKR"]
    history             GameHistory[]

    // --- NEW CATALOG FIELDS ---
    gameUid             String?       // Actual integration code from the catalog
    vendorId            String?       @db.ObjectId
    vendor              Provider?     @relation(fields: [vendorId], references: [id])
    normalizedName      String?
    subCategory         String?
    description         String?
    banner              String?
    launchType          String?
    launchUrl           String?
    mode                String?
    isActive            Boolean       @default(true)
    isFeatured          Boolean       @default(false)
    isPopular           Boolean       @default(false)
    sortOrder           Int           @default(0)
    metadata            Json?
    createdAt           DateTime?     @default(now())
    updatedAt           DateTime?     @updatedAt
  }

  model GameHistory {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    userId      String      @db.ObjectId
    gameId      String      @db.ObjectId
    game        Game        @relation(fields: [gameId], references: [id])
    roundId     String
    betAmount   Float
    winAmount   Float
    status      RoundStatus
    providerRef String?
    createdAt   DateTime    @default(now())
  }

  model PaymentSetting {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    upiId     String
    qrCodeUrl String?
    withdrawFeePercent Float @default(0)
    isActive  Boolean  @default(true)
    updatedAt DateTime @updatedAt
  }

  model SupportSetting {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    whatsappNumber  String
    updatedAt       DateTime @updatedAt
  }
