  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
  }

  enum Role {
    USER
    ADMIN
    SUPER_ADMIN
  }

  enum Status {
    ACTIVE
    INACTIVE
    BANNED
  }

  enum TxType {
    DEPOSIT
    WITHDRAWAL
    BET
    WIN
    REFUND
    BONUS
    ADJUSTMENT
  }

  enum TxStatus {
    PENDING
    COMPLETED
    FAILED
    ROLLED_BACK
  }

  enum RoundStatus {
    OPEN
    RESOLVED
    CANCELLED
  }

  model User {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    username     String?   @unique
    mobile       String?   @unique
    email        String?   @unique
    googleId     String?   @unique
    passwordHash String
    role         Role      @default(USER)
    status       Status    @default(ACTIVE)
    wallet       Wallet?
    sessions     Session[]
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
  }

  model Session {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    user      User     @relation(fields: [userId], references: [id])
    token     String   @unique
    device    String?
    ip        String?
    expiresAt DateTime
    createdAt DateTime @default(now())
  }

  model Wallet {
    id            String        @id @default(auto()) @map("_id") @db.ObjectId
    userId        String        @unique @db.ObjectId
    user          User          @relation(fields: [userId], references: [id])
    balance       Float         @default(0.00)
    lockedBalance Float         @default(0.00)
    currency      String        @default("INR")
    status        Status        @default(ACTIVE)
    transactions  Transaction[]
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
  }

  model Transaction {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    walletId       String   @db.ObjectId
    wallet         Wallet   @relation(fields: [walletId], references: [id])
    amount         Float
    type           TxType
    status         TxStatus
    referenceId    String?   // External reference (provider transaction id)
    idempotencyKey String   @unique
    gameHistoryId  String?  @db.ObjectId
    description    String?
    metadata       Json?
    createdAt      DateTime @default(now())
  }

  model Game {
    id           String        @id @default(auto()) @map("_id") @db.ObjectId
    slug         String        @unique
    name         String
    category     String
    providerId   String
    thumbnail    String?
    status       Status        @default(ACTIVE)
    minBet       Float?
    maxBet       Float?
    displayOrder Int           @default(0)
    history      GameHistory[]
  }

  model GameHistory {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    userId      String      @db.ObjectId
    gameId      String      @db.ObjectId
    game        Game        @relation(fields: [gameId], references: [id])
    roundId     String
    betAmount   Float
    winAmount   Float
    status      RoundStatus
    providerRef String?
    createdAt   DateTime    @default(now())
  }
